{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alaa-legal-assistant",
  "main": "src/worker-v3.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  }
}
